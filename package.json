{
  "name": "patchwork-harness",
  "version": "0.1.0",
  "description": "The verifying harness for AI coding agents: multi-vendor routing, test gates, independent review and grounded answers, with every action on the Patchwork audit trail.",
  "type": "module",
  "bin": {
    "patchwork-harness": "./bin/patchwork-harness.mjs",
    "pwh": "./bin/patchwork-harness.mjs"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --clean --dts",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^2.0.1",
    "@octokit/rest": "^21.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fast-glob": "^3.3.2",
    "hono": "^4.12.16",
    "js-yaml": "^4.1.0",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "BUSL-1.1",
  "author": "Jono Gitty",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonoGitty/patchwork-harness.git"
  },
  "homepage": "https://github.com/JonoGitty/patchwork-harness#readme",
  "bugs": {
    "url": "https://github.com/JonoGitty/patchwork-harness/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "llm",
    "claude",
    "gpt",
    "gemini",
    "verification",
    "eval",
    "mcp",
    "patchwork",
    "audit"
  ]
}
